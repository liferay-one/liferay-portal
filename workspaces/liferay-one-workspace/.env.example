# Workspace environment variables for client extensions.
#
# Copy this file to .env and fill in real values. The .env file is loaded into
# the liferay-one-etc-spring-boot container by docker-compose.yaml, layered
# after build/local.env so the values here override the "unused" placeholders
# that buildDockerImage generates.
#
# Keys mirror the ${VAR} placeholders in
# client-extensions/liferay-one-etc-spring-boot/src/main/resources/application-default.properties.
#
# Fill in real values for the integrations you need; leave the rest blank to
# keep them disabled locally.

#
# Application
#

LIFERAY_ONE_GCS_BUCKET_NAME=
LIFERAY_ONE_GCS_SERVICE_ACCOUNT_KEY=
LIFERAY_ONE_JIRA_API_EMAIL_ADDRESS=
LIFERAY_ONE_JIRA_API_TOKEN=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_ACCOUNT=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_ACTUAL_EVENT_DATE=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_ASSOCIATED_TICKETS=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_AUTHOR=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_CURRENT_VERSION=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_DESCRIPTION=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_EVENT_STATUS=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_EVENT_TYPE=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_LAST_COMMENT=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_LAST_UPDATED_AUTHOR=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_NAME=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_NEW_VERSION=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_PLANNED_EVENT_DATE=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ATTRIBUTE_TIME_ZONE=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_ASSET_OBJECT_TYPE_ID=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_VERSION_ASSET_OBJECT_TYPE_ATTRIBUTE_AUTHOR=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_VERSION_ASSET_OBJECT_TYPE_ATTRIBUTE_CHANGE=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_VERSION_ASSET_OBJECT_TYPE_ATTRIBUTE_COMMENT=
LIFERAY_ONE_JIRA_BUSINESS_EVENT_VERSION_ASSET_OBJECT_TYPE_ATTRIBUTE_CREATED=
LIFERAY_ONE_JIRA_ORGANIZATION_ASSET_OBJECT_TYPE_ATTRIBUTE_EXTERNAL_KEY=
LIFERAY_ONE_JIRA_SUPPORT_FLS_PORTAL_URL=
LIFERAY_ONE_JIRA_SUPPORT_FLS_PROJECT=
LIFERAY_ONE_JIRA_SUPPORT_HC_FIELD_ORGANIZATION=
LIFERAY_ONE_JIRA_SUPPORT_HC_FIELD_REQUEST_TYPE=
LIFERAY_ONE_JIRA_SUPPORT_HC_PORTAL_URL=
LIFERAY_ONE_JIRA_SUPPORT_HC_PROJECT=
LIFERAY_ONE_JIRA_URL=
LIFERAY_ONE_JIRA_WORKSPACE_ID=
LIFERAY_ONE_PORTAL_URL=http://localhost:8080

#
# OAuth
#

LIFERAY_ONE_ETC_SPRING_BOOT_OAHS_CLIENT_SECRET=myfancypassword

#
# Okta
#

LIFERAY_ONE_OKTA_API_TOKEN=
LIFERAY_ONE_OKTA_HOST=
LIFERAY_ONE_OKTA_PUBSUB_PUBLISHER_PROJECT_ID=

#
# Salesforce
#

LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_ENABLED=false
LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_PROJECT_ID=
