# Workspace environment variables for client extensions.
#
# Copy this file to .env and fill in real values. The .env file is loaded into
# the liferay-one-etc-spring-boot container by docker-compose.yaml, layered
# after build/local.env so the values here override the "unused" placeholders
# that buildDockerImage generates.
#
# Keys mirror the ${VAR} placeholders in the client extensions, primarily
# client-extensions/liferay-one-etc-spring-boot/src/main/resources/application-default.properties
# and client-extensions/liferay-one-instance-settings/client-extension.yaml.
#
# Fill in real values for the integrations you need; leave the rest blank to
# keep them disabled locally.

#
# Application
#

LIFERAY_ONE_GCF_BASE_URL=
LIFERAY_ONE_GCS_BUCKET_NAME=
LIFERAY_ONE_GCS_SERVICE_ACCOUNT_KEY=
LIFERAY_ONE_JIRA_API_EMAIL_ADDRESS=
LIFERAY_ONE_JIRA_API_TOKEN=
LIFERAY_ONE_JIRA_ASSET_SCHEMA_NAME=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_COUNTRY=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_OFFERING=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_ORGANIZATION=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_OWNER=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_PROVISIONING_COMPONENT=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_FIELD_SUPPORT_REGION=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_ID=
LIFERAY_ONE_JIRA_ISSUE_PROVISIONING_OFFERING_ID=
LIFERAY_ONE_JIRA_ISSUE_SUPPORT_HC_FIELD_ORGANIZATION=
LIFERAY_ONE_JIRA_ISSUE_SUPPORT_HC_FIELD_REQUEST_TYPE=
LIFERAY_ONE_JIRA_ORGANIZATION_PROVISIONING_ID=
LIFERAY_ONE_JIRA_PROJECT_SUPPORT_FLS=
LIFERAY_ONE_JIRA_PROJECT_SUPPORT_FLS_URL=
LIFERAY_ONE_JIRA_PROJECT_SUPPORT_HC=
LIFERAY_ONE_JIRA_PROJECT_SUPPORT_HC_URL=
LIFERAY_ONE_JIRA_REQUEST_PROVISIONING_ID=
LIFERAY_ONE_JIRA_URL=
LIFERAY_ONE_JIRA_WORKSPACE_ID=
LIFERAY_ONE_PORTAL_URL=http://localhost:8080

#
# Dead Letter
#

LIFERAY_ONE_DEAD_LETTER_NOTIFICATION_RECIPIENT=
LIFERAY_ONE_DEAD_LETTER_PUBSUB_SUBSCRIBER_ENABLED=false
LIFERAY_ONE_DEAD_LETTER_PUBSUB_SUBSCRIBER_PROJECT_ID=
LIFERAY_ONE_DEAD_LETTER_PUBSUB_SUBSCRIBER_SUBSCRIPTION=

#
# OAuth
#

LIFERAY_ONE_ETC_SPRING_BOOT_OAHS_CLIENT_SECRET=myfancypassword

#
# Okta
#

LIFERAY_ONE_OKTA_API_TOKEN=
LIFERAY_ONE_OKTA_HOST=
LIFERAY_ONE_OKTA_PUBSUB_PUBLISHER_PROJECT_ID=

#
# Provisioning
#

LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_AUSTRALIA=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_BRAZIL=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_CHINA=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_GLOBAL=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_HUNGARY=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_INDIA=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_JAPAN=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_SPAIN=
LIFERAY_ONE_PROVISIONING_EMAIL_ADDRESS_US=
LIFERAY_ONE_PROVISIONING_PARTNER_USER_UPDATE_RECIPIENT=

#
# Salesforce
#

LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_ENABLED=false
LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_PROJECT_ID=
LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_SUBSCRIPTION=
LIFERAY_ONE_SALESFORCE_OBJECT_PUBSUB_SUBSCRIBER_TOPIC=
LIFERAY_ONE_SALESFORCE_OPPORTUNITY_PUBSUB_SUBSCRIBER_ENABLED=false
LIFERAY_ONE_SALESFORCE_OPPORTUNITY_PUBSUB_SUBSCRIBER_PROJECT_ID=
LIFERAY_ONE_SALESFORCE_OPPORTUNITY_PUBSUB_SUBSCRIBER_SUBSCRIPTION=
LIFERAY_ONE_SALESFORCE_OPPORTUNITY_PUBSUB_SUBSCRIBER_TOPIC=one-liferay-opp-entries

#
# Teardown (scripts/teardown*.sh)
#
# Target and OAuth2 client-credentials app for running the teardown scripts
# against a remote environment such as UAT. Source this file before running, or
# export these in your shell -- the teardown scripts read them from the
# environment, not from docker-compose. The OAuth app must be granted the
# headless, object-admin, and per-object ".everything" scopes the teardown uses.
#

LIFERAY_URL=
LIFERAY_OAUTH_CLIENT_ID=
LIFERAY_OAUTH_CLIENT_SECRET=
