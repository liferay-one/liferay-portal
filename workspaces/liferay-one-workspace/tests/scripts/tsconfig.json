{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": [
			"esnext"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noUnusedLocals": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"types": [
			"node"
		]
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"**/*.ts"
	]
}